{
  "name": "<%- projectName %>",
  "version": "<%- version %>",
  "description": "<%- description %>",
  "author": {
    "name": "<%- authorName %>",
    "email": "<%- email %>",
    "url": "<%- profileUrl %>"
  },
  "funding": "<%- fundingUrl %>",
  "homepage": "<%- homepageUrl %>",
  "repository": {
    "directory": "<%- directory %>",
    "type": "github",
    "url": "<%- repositoryUrl %>"
  },
  "icon": "<%- iconUrl %>",
  "keywords": [
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "bin": {
    "<%- orgName %>-<%- fileName %>": "./bin/<%- fileName %>.mjs"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "bun": "./src/api/index.ts",
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./data": {
      "bun": "./src/data/index.ts",
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    }
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "<%- directory %>/src",
    "projectType": "library",
    "tags": [
      "app:nest"
    ],
    "targets": {
      "build": {},
      "serve": {},
      "doc": {}
    }
  },
  "dependencies": {
    "@aenode/constants": "workspace:*",
    "@aenode/nest": "workspace:*",
    "@aenode/nest-boot": "workspace:*"
  }
}
