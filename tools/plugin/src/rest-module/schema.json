{
  "$schema": "https://json-schema.org/schema",
  "$id": "RestModule",
  "title": "Nestjs rest module",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "Project name",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What project would you like to use?"
    },

    "name": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Resource name",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "x-prompt": "What names would you like to use?"
    }
  },
  "required": ["project", "name"]
}
