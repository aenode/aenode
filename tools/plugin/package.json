{
  "name": "@aenode/plugin",
  "version": "0.0.45",
  "description": "Aenode project/resource generator",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aenode+aenode@proton.me",
    "url": "https://aenode.github.io/#profile"
  },
  "bin": {
    "aenode-plugin": "./bin/plugin.mjs"
  },
  "funding": "https://cash.app/$puqlib",
  "homepage": "https://aenode.github.io/aenode/tools/plugin",
  "repository": {
    "directory": "tools/plugin",
    "type": "github",
    "url": "https://github.com/aenode/aenode/tree/main/tools/plugin"
  },
  "icon": "https://aenode.github.io/aenode/tools/plugin/assets/favicon.svg",
  "keywords": [
    "nestjs",
    "rest",
    "utils"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json"
  ],
  "nx": {
    "projectType": "library",
    "tags": [
      "cli:cli"
    ],
    "targets": {
      "build": {
        "outputPath": "tools/plugin/dist",
        "options": {
          "assets": [
            {
              "input": "./tools/plugin/src",
              "glob": "**/!(*.ts)",
              "output": "."
            }
          ]
        }
      },
      "doc": {}
    }
  },
  "dependencies": {
    "@nx/devkit": "24.0.3",
    "@aenode/names": "workspace:*",
    "@swc/helpers": "~0.5.18"
  },
  "generators": "./generators.json"
}
