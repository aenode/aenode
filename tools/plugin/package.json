{
  "name": "@aenode/plugin",
  "description": "Nx plugin that provides a set of project generators.",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "generators.json",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "tools/plugin/src",
    "tags": [
      "shared:dev"
    ],
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "tools/plugin/dist",
          "main": "tools/plugin/src/index.ts",
          "tsConfig": "tools/plugin/tsconfig.lib.json",
          "skipTypeCheck": false,
          "stripLeadingPaths": true,
          "assets": [
            {
              "input": "./tools/plugin/src",
              "glob": "**/!(*.ts)",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "^24.0.7",
    "@swc/helpers": "~0.5.18"
  },
  "generators": "./generators.json"
}
