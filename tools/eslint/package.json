{
  "name": "@aenode/eslint",
  "description": "Common eslint configurations",
  "version": "0.0.1",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aenode+npm@proton.me",
    "url": "https://aenode.github.io"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "homepage": "https://aenode.github.io/aenode/tools/eslint",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./angular": {
      "types": "./dist/lib/angular.d.ts",
      "import": "./dist/lib/angular.js",
      "default": "./dist/lib/angular.js"
    },
    "./nestjs": {
      "types": "./dist/lib/nestjs.d.ts",
      "import": "./dist/lib/nestjs.js",
      "default": "./dist/lib/nestjs.js"
    },
    "./nodejs": {
      "types": "./dist/lib/nodejs.d.ts",
      "import": "./dist/lib/nodejs.js",
      "default": "./dist/lib/nodejs.js"
    },
    "./shared": {
      "types": "./dist/lib/shared.d.ts",
      "import": "./dist/lib/shared.js",
      "default": "./dist/lib/shared.js"
    },
    "./nx-plugin": {
      "types": "./dist/lib/nx-plugin.d.ts",
      "import": "./dist/lib/nx-plugin.js",
      "default": "./dist/lib/nx-plugin.js"
    },
    "./dev": {
      "types": "./dist/lib/dev.d.ts",
      "import": "./dist/lib/dev.js",
      "default": "./dist/lib/dev.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "tools/eslint/src",
    "tags": [
      "shared:dev"
    ],
    "targets": {
      "build": {}
    }
  },
  "dependencies": {
    "@nx/eslint-plugin": "^24.0.7",
    "@swc/helpers": "~0.5.18",
    "eslint-plugin-unicorn": "^80.0.0",
    "jsonc-eslint-parser": "^3.3.0",
    "typescript-eslint": "^8.58.0"
  }
}
