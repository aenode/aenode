{
  "name": "@aenode/cli",
  "version": "0.0.47",
  "description": "Aenode CLI",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aenode+aenode@-cliproton.me",
    "url": "https://aenode.github.io/#profile"
  },
  "bin": {
    "aenode": "./bin/aenode.mjs"
  },
  "funding": "https://cash.app/$puqlib",
  "homepage": "https://aenode.github.io/aenode/tools/cli",
  "repository": {
    "directory": "tools/cli",
    "type": "github",
    "url": "https://github.com/aenode/aenode/tree/main/tools/cli"
  },
  "icon": "https://aenode.github.io/aenode/tools/cli/assets/favicon.svg",
  "keywords": [
    "lib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "generators.json",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "tools/cli/src",
    "projectType": "library",
    "tags": [
      "cli:cli"
    ],
    "targets": {
      "build": {},
      "doc": {},
      "serve": {}
    }
  },
  "dependencies": {
    "@aenode/names": "workspace:*",
    "@swc/helpers": "~0.5.18",
    "commander": "^15.0.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/uuid": "^11.0.0"
  }
}
