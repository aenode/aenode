{
  "name": "@aenode/cli",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json"
  ],
  "nx": {
    "targets": {
      "build": {
        "options": {
          "outputPath": "tools/cli/dist",
          "assets": [
            {
              "input": "./tools/cli/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./tools/cli/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "23.2.1",
    "@swc/helpers": "~0.5.18",
    "vitest": "^5.0.0"
  },
  "generators": "./generators.json"
}
