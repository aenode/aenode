{
  "name": "@aenode/aenode-db",
  "version": "0.0.40",
  "description": "Aenode databases",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aenode+aenode+aenode-aenode-db@proton.me",
    "url": "https://aenode.github.io/#profile"
  },
  "funding": "https://cash.app/$puqlib",
  "homepage": "https://aenode.github.io/aenode/databases/aenode-db",
  "repository": {
    "directory": "databases/aenode-db",
    "type": "github",
    "url": "https://github.com/aenode/aenode/tree/main/databases/aenode-db"
  },
  "icon": "https://aenode.github.io/aenode/databases/aenode-db/assets/favicon.svg",
  "keywords": [
    "database",
    "prisma"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "bin": {
    "aenode-aenode-db": "./bin/aenode-db.mjs"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "bun": "./src/generated/prisma/client.ts",
      "types": "./dist/generated/prisma/client.d.ts",
      "import": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    },
    "./client": {
      "bun": "./src/generated/prisma/client.ts",
      "types": "./dist/generated/prisma/client.d.ts",
      "import": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    },
    "./browser": {
      "bun": "./src/generated/prisma/browser.ts",
      "types": "./dist/generated/prisma/browser.d.ts",
      "import": "./dist/generated/prisma/browser.js",
      "default": "./dist/generated/prisma/browser.js"
    },
    "./models": {
      "bun": "./src/generated/prisma/models.ts",
      "types": "./dist/generated/prisma/models.d.ts",
      "import": "./dist/generated/prisma/models.js",
      "default": "./dist/generated/prisma/models.js"
    },
    "./enums": {
      "bun": "./src/generated/prisma/enums.ts",
      "types": "./dist/generated/prisma/enums.d.ts",
      "import": "./dist/generated/prisma/enums.js",
      "default": "./dist/generated/prisma/enums.js"
    },
    "./nest": {
      "bun": "./src/generated/nest/index.ts",
      "types": "./dist/generated/nest/index.d.ts",
      "import": "./dist/generated/nest/index.js",
      "default": "./dist/generated/nest/index.js"
    }
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "prisma",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "databases/aenode-db/src",
    "projectType": "library",
    "tags": [
      "data:prisma"
    ],
    "targets": {
      "build": {
        "dependsOn": [
          "prisma:generate"
        ]
      },
      "doc": {},
      "prisma:generate": {},
      "prisma:migrate": {},
      "prisma:reset": {}
    }
  },
  "dependencies": {
    "@aenode/prop": "workspace:*",
    "@prisma/client": "7.8.0",
    "@swc/helpers": "~0.5.18"
  },
  "devDependencies": {
    "@aenode/prisma-plugin": "workspace:*"
  }
}
