{
  "name": "@aenode/iam-db",
  "version": "0.0.23",
  "description": "Identity and access management database",
  "keywords": [
    "database",
    "prisma",
    "orm"
  ],
  "license": "BSL-1.0",
  "author": {
    "email": "aenode+aenode+iam-db@proton.me",
    "name": "Ahmet Emrebas",
    "url": "https://aenode.github.io"
  },
  "homepage": "https://aenode.github.io/aenode/databases/iam-db",
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dtos": {
      "types": "./dist/generated/dtos/index.d.ts",
      "import": "./dist/generated/dtos/index.js",
      "default": "./dist/generated/dtos/index.js"
    },
    "./browser": {
      "types": "./dist/generated/prisma/browser.d.ts",
      "import": "./dist/generated/prisma/browser.js",
      "default": "./dist/generated/prisma/browser.js"
    },
    "./client": {
      "types": "./dist/generated/prisma/client.d.ts",
      "import": "./dist/generated/prisma/client.js",
      "default": "./dist/generated/prisma/client.js"
    },
    "./models": {
      "types": "./dist/generated/prisma/models.d.ts",
      "import": "./dist/generated/prisma/models.js",
      "default": "./dist/generated/prisma/models.js"
    },
    "./enums": {
      "types": "./dist/generated/prisma/enums.d.ts",
      "import": "./dist/generated/prisma/enums.js",
      "default": "./dist/generated/prisma/enums.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "databases/iam-db/src",
    "tags": [
      "app:prisma"
    ],
    "targets": {
      "build": {},
      "lint": {},
      "doc": {},
      "prisma:migrate": {},
      "prisma:generate": {},
      "prisma:reset": {}
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.23"
  },
  "devDependencies": {
    "@aenode/nestjs": "workspace:*",
    "@aenode/prisma-plugins": "workspace:*",
    "@prisma/client": "^7.9.0",
    "dotenv": "^17.4.2"
  },
  "peerDependencies": {
    "@aenode/nestjs": "workspace:*",
    "@prisma/client": "^7.9.0"
  }
}
