generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Phone {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  phone String

  userPhones UserPhone[]
}

model Email {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  email String

  userEmails UserEmail[]
}

model Country {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  name      String @unique
  code      String @unique
  phoneCode String @unique @map("phone_code")

  subdivisions Subdivision[]
  addresses    Address[]

  @@map("countries")
}

model Subdivision {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  name String @unique
  code String @unique

  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  countryId Int     @map("country_id")

  addresses Address[]

  @@index([countryId])
  @@map("subdivisions")
}

model Address {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  line1      String
  line2      String
  city       String
  postalCode String
  note       String?

  country     Country @relation(fields: [countryCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  countryCode String  @map("country_code")

  subdivision     Subdivision @relation(fields: [subdivitionCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  subdivitionCode String      @map("subdivition_code")

  userAddresses UserAddress[]

  @@index([countryCode])
  @@index([subdivitionCode])
  @@map("addresses")
}

model UserEmail {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int

  email   Email @relation(fields: [emailId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  emailId Int

  @@unique([userId, emailId])
  @@map("user_emails")
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int  @map("user_id")

  address   Address @relation(fields: [addressId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  addressId Int     @map("address_id")

  @@unique([userId, addressId])
  @@map("user_addresses")
}

model UserPhone {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int

  phone   Phone @relation(fields: [phoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  phoneId Int

  @@unique([userId, phoneId])
  @@map("user_phones")
}

model User {
  id   Int    @id @default(autoincrement())
  uuid String @unique @db.Uuid

  userEmails    UserEmail[]
  userAddresses UserAddress[]
  userPhones    UserPhone[]
}
