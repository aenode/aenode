{
  "name": "@aenode/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "aenode:prune": "rm -rf node_module rm -rf **/**/node_modules **/**/dist **/**/out-tsc **/**/test-output"
  },
  "private": true,
  "dependencies": {},
  "devDependencies": {
    "@aenode/eslint": "workspace:*",
    "@aenode/iam": "workspace:*",
    "@aenode/plugin": "workspace:*",
    "@eslint/js": "^9.8.0",
    "@nx/eslint": "24.0.7",
    "@nx/eslint-plugin": "24.0.7",
    "@nx/js": "24.0.7",
    "@nx/plugin": "^24.0.7",
    "@nx/vitest": "24.0.7",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "24.0.7",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "verdaccio": "^6.3.2",
    "vite": "^8.0.0",
    "vitest": "~5.0.1"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "libs/*",
    "apps/*",
    "tools/*",
    "app/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  }
}
