    "name": "Ahmet Emrebas",
    "email": "aenode+aenode+aenode-dtos@proton.me",
    "url": "https://aenode.github.io/#profile"
  },
  "funding": "https://cash.app/$puqlib",
  "homepage": "https://aenode.github.io/aenode/libs/dtos",
  "repository": {
    "directory": "libs/dtos",
    "type": "github",
    "url": "https://github.com/aenode/aenode/tree/main/libs/dtos"
