#!/bin/sh

# Count staged files (excluding deleted/renamed flags, strictly staged paths)
STAGED_COUNT=$(git diff --cached --name-only | wc -l | tr -d ' ')

if [ "$STAGED_COUNT" -gt 50 ]; then
  echo "\031[31m[ERROR] Commit rejected: You are trying to commit $STAGED_COUNT files.\033[0m"
  echo "This repository restricts commits to a maximum of 50 file at a time."
  echo ""
  echo "Staged files:"
  git diff --cached --name-only | sed 's/^/  - /'
  exit 1
fi

