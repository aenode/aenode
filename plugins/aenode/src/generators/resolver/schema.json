{
  "$schema": "https://json-schema.org/schema",
  "$id": "Resolver",
  "title": "",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Resource name",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?"
    },

    "project": {
      "type": "string",
      "description": "Project name",
      "$default": {
        "$source": "argv",
        "index": 1
      },
      "x-prompt": "What project would you like to use?"
    },

    "directory": {
      "type": "string",
      "description": "Resource directory",
      "$default": {
        "$source": "argv",
        "index": 2
      },
      "x-prompt": "What directory would you like to use?"
    }
  },
  "required": ["project", "directory", "name"]
}
