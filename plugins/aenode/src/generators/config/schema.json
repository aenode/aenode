{
  "$schema": "https://json-schema.org/schema",
  "$id": "Config",
  "title": "Generate build, lint, and ts configurations",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "Project name",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What project would you like to use?"
    }
  },
  "required": ["project"]
}
