{
  "name": "@aenode/prisma-plugins",
  "version": "0.0.21",
  "description": "Prisma plugins",
  "keywords": [
    "types"
  ],
  "license": "BSL-1.0",
  "author": {
    "email": "aenode+aenode+prisma-plugins@proton.me",
    "name": "Ahmet Emrebas",
    "url": "https://aenode.github.io"
  },
  "homepage": "https://aenode.github.io/aenode/plugins/prisma-plugins",
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "!**/*.tsbuildinfo"
  ],
  "bin": {
    "aenode-graphql": "./bin/aenode-graphql.mjs",
    "aenode-controller": "./bin/aenode-controller.mjs",
    "aenode-resolver": "./bin/aenode-resolver.mjs"
  },
  "nx": {
    "sourceRoot": "plugins/prisma-plugins/src",
    "tags": [
      "lib:plugin"
    ],
    "targets": {
      "build": {},
      "lint": {},
      "doc": {}
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.18"
  },
  "devDependencies": {
    "@aenode/flow": "workspace:*",
    "@aenode/fs": "workspace:*",
    "@aenode/is": "workspace:*",
    "@aenode/names": "workspace:*",
    "@aenode/prop-options": "workspace:*",
    "@prisma/client": "^7.9.0",
    "@prisma/generator-helper": "^7.10.0",
    "dotenv": "^17.4.2"
  },
  "peerDependencies": {
    "@aenode/fs": "workspace:*",
    "@aenode/is": "workspace:*",
    "@aenode/names": "workspace:*",
    "@aenode/prop-options": "workspace:*",
    "@prisma/generator-helper": "^7.10.0"
  }
}
