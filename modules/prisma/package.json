{
  "name": "@aenode/prisma",
  "version": "0.0.23",
  "description": "Nestjs prisma module",
  "keywords": [
    "types"
  ],
  "license": "BSL-1.0",
  "author": {
    "email": "aenode+aenode+prisma@proton.me",
    "name": "Ahmet Emrebas",
    "url": "https://aenode.github.io"
  },
  "homepage": "https://aenode.github.io/aenode/modules/prisma",
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pg": {
      "types": "./dist/pg/index.d.ts",
      "import": "./dist/pg/index.js",
      "default": "./dist/pg/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.js",
      "default": "./dist/sqlite/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "modules/prisma/src",
    "tags": [
      "lib:module"
    ],
    "targets": {
      "build": {},
      "lint": {},
      "doc": {}
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.18",
    "@aenode/env": "workspace:*",
    "@aenode/names": "workspace:*",
    "@nestjs/common": "~12.0.0",
    "@nestjs/config": "~12.0.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.0",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "dotenv": "^17.4.2"
  }
}
