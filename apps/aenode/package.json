{
  "name": "@aenode/aenode",
  "version": "0.0.1",
  "description": "Nestjs module exports. The project is for managing the module versions",
  "author": {
    "name": "Ahmet Emrebas",
    "email": "aenode+aenode@proton.me",
    "url": "https://aenode.github.io/#profile"
  },
  "bin": {
    "aenode-api": "./bin/aenode.mjs"
  },
  "funding": "https://cash.app/$puqlib",
  "homepage": "https://aenode.github.io/aenode/libs/nest",
  "repository": {
    "directory": "libs/nest",
    "type": "github",
    "url": "https://github.com/aenode/aenode/tree/main/libs/nest"
  },
  "icon": "https://aenode.github.io/aenode/libs/nest/favicon.svg",
  "keywords": [
    "nestjs",
    "rest",
    "utils"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "bun": "./src/app/index.ts",
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js",
      "default": "./dist/app/index.js"
    }
  },
  "files": [
    "assets",
    "bin",
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "projectType": "application",
    "tags": [
      "app:node"
    ],
    "targets": {
      "build": {},
      "serve": {},
      "doc": {}
    }
  },
  "dependencies": {
    "@aenode/constants": "workspace:*",
    "@aenode/nest": "workspace:*",
    "@aenode/nest-boot": "workspace:*",
    "@aenode/contact-db": "0.0.1"
  }
}
