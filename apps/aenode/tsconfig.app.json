{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [
      "node"
    ],
    "rootDir": "src",
    "emitDeclarationOnly": false,
    "rewriteRelativeImportExtensions": true,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "vitest.config.mts",
    "eslint.config.mjs"
  ],
  "references": []
}