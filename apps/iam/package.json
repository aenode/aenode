{
  "name": "@aenode/iam",
  "description": "Iam - Identity and access management service",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "apps/iam/src",
    "targets": {
      "build": {
        "executor": "@nx/js:swc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "apps/iam/dist",
          "main": "apps/iam/src/index.ts",
          "tsConfig": "apps/iam/tsconfig.lib.json",
          "skipTypeCheck": true,
          "stripLeadingPaths": true
        }
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun --watch apps/iam/src/main.ts"
        }
      },
      "docker-build": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "docker build -t aenode-iam apps/iam"
        }
      },
      "docker-run": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "docker-build"
        ],
        "options": {
          "command": "docker rm -f aenode-iam 2>/dev/null; docker run --name aenode-iam -p 3000:3000 aenode-iam"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^12.6.3",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.3",
    "@nestjs/event-emitter": "^12.0.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/swagger": "^12.1.3",
    "@nestjs/terminus": "^12.2.0",
    "@swc/helpers": "~0.5.18"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.6.3"
  }
}
