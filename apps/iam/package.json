{
  "name": "@aenode/iam",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./data": {
      "bun": "./src/data/index.ts",
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js",
      "default": "./dist/data/index.js"
    },
    "./app": {
      "bun": "./src/app/index.ts",
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js",
      "default": "./dist/app/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "apps/iam/src",
    "tags": [
      "app:api"
    ],
    "targets": {
      "build": {},
      "lint": {},
      "test": {},
      "doc": {},
      "serve": {},
      "prisma:generate": {},
      "prisma:migrate": {},
      "prisma:reset": {}
    }
  },
  "dependencies": {
    "@aenode/nest": "workspace:*",
    "@aenode/nest-auth": "workspace:*",
    "@aenode/nest-crypto": "workspace:*",
    "@aenode/prisma": "workspace:*",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.0",
    "@prisma/client": "7.8.0",
    "@swc/helpers": "~0.5.18",
    "express": "^5.2.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/uuid": "^11.0.0"
  }
}
