{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "types": ["node", "@types/node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/prisma/tsconfig.lib.json"
    },
    {
      "path": "../../libs/nest-crypto/tsconfig.lib.json"
    },
    {
      "path": "../../libs/nest-auth/tsconfig.lib.json"
    },
    {
      "path": "../../libs/nest/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "prisma.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ]
}
