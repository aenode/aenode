generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator prismaDto {
  provider = "prisma-dto"
  output   = "../src/generated/dto"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  NEW
  IN_PROGRESS
  DONE
}

model Scope {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  /// @format(name) @citext
  name String @unique

  resources Resource[]

  @@map("scopes")
}

model User {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  /// @format(email) @citext
  username String @unique

  /// @format(password) @writeonly
  password String

  avatar String? @default("person.svg")

  sessions        Session[]
  otps            Otp[]
  userPermissions UserPermission[]
  userRoles       UserRole[]

  @@map("users")
}

model Otp {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  /// @encript
  secret  String
  enabled Boolean @default(false)

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int  @unique @map("user_id")

  @@map("otps")
}

model Session {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")
  deviceId  String  @map("device_id")
  usage     Int     @default(0)

  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@map("sessions")
}

model Resource {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  /// @format(name) @citext
  name String @unique

  scope   Scope @relation(fields: [scopeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  scopeId Int   @map("scope_id")

  permissions Permission[]

  @@unique([name, scopeId])
  @@index([scopeId])
  @@map("resources")
}

model Operation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  /// @format(name) @citext
  name String @unique

  permissions Permission[]

  @@map("operations")
}

model Permission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  resourceId Int      @map("resource_id")

  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  operationId Int       @map("operation_id")

  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@unique([resourceId, operationId])
  @@map("permissions")
}

model Role {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  /// @format(name) @citext
  name String @unique

  /// @include
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissionId Int        @map("permission_id")

  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roleId Int  @map("role_id")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int  @map("user_id")

  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  roleId Int  @map("role_id")

  @@unique([userId, roleId])
  @@map("user_roles")
}

model UserPermission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId Int  @map("user_id")

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permissionId Int        @map("permission_id")

  @@unique([userId, permissionId])
  @@map("user_permissions")
}
