generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator prismaDto {
  provider = "prisma-dto"
  output   = "../src/generated/dto"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  NEW
  IN_PROGRESS
  DONE
}

model User {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid(7)) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  /// @format(email)
  username String @unique @db.Citext

  /// @format(password) @writeonly
  password String

  avatar String? @default("person.svg")

  /// @include
  comments        Comment[]
  userTasks       UserTask[]
  sessions        Session[]
  otps            Otp[]
  userPermissions UserPermission[]

  @@map("users")
}

model Otp {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  /// @encript
  secret String

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @unique @map("user_id")

  @@map("otps")
}

model Session {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  userAgent String? @map("user_agent")
  ipAddress String? @map("ip_address")
  deviceId  String  @default("deviceId") @map("device_id")
  usage     Int?    @default(0)

  user   User @relation(fields: [userId], references: [id])
  userId Int  @map("user_id")

  @@unique([deviceId, isActive])
  @@map("sessions")
}

model Scope {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  name String @unique @db.Citext

  resources Resource[]

  @@map("scopes")
}

model Resource {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  name String @db.Citext

  scope   Scope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  scopeId Int   @map("scope_id")

  permissions Permission[]

  @@unique([name, scopeId])
  @@index([scopeId])
  @@map("resources")
}

model Operation {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  name String @unique @db.Citext

  permissions Permission[]

  @@map("operations")
}

model Permission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  resourceId Int      @map("resource_id")

  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  operationId Int       @map("operation_id")

  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@unique([resourceId, operationId])
  @@map("permissions")
}

model Role {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  name String @unique

  /// @include
  rolePermissions RolePermission[]
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  permission   Permission @relation(fields: [permissionId], references: [id])
  permissionId Int        @map("permission_id")

  role   Role @relation(fields: [roleId], references: [id])
  roleId Int  @map("role_id")

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserPermission {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")

  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId Int        @map("permission_id")

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  comment String

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId Int  @map("task_id")

  /// @include(username,avatar)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")
}

model Task {
  id Int @id @default(autoincrement())

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  /// @minlength(3) @maxlength(255)
  title String @unique @db.Citext

  /// @slug(title)
  slug String @unique @db.Citext

  description String?

  /// @lessThan(endDate)
  /// @lessThan(dueDate)
  startDate DateTime @map("start_date")

  /// @morethan(startDate)
  endDate DateTime? @map("end_date")

  /// @morethan(startDate)
  dueDate DateTime @map("due_date")

  /// @maxitems(5)
  tags String[]

  /// @min(0) @max(100)
  score Int

  /// @include
  comments Comment[]

  userTasks UserTask[]

  status Status? @default(NEW)
}

model UserTask {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  isActive  Boolean  @default(true) @map("is_active")

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")

  /// @include
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId Int  @map("task_id")

  @@unique(fields: [userId, taskId], map: "userId_taskId")
  @@index([taskId])
}
