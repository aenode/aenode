{
  "name": "@aenode/brand-email",
  "version": "0.0.5",
  "description": "Transform an email address into a branded email, ex. `some@some.com` to `some+your-brand@some.com`",
  "keywords": [
    "utils",
    "email",
    "brand-email"
  ],
  "license": "BSL-1.0",
  "author": {
    "email": "aenode+brand-email@proton.me",
    "name": "Ahmet Emrebas",
    "url": "https://aenode.github.io"
  },
  "icon": "https://aenode.github.io/aenode/utils/brand-email",
  "homepage": "https://aenode.github.io/aenode/utils/brand-email",
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "utils/brand-email/src",
    "tags": [
      "lib:utils"
    ],
    "targets": {
      "build": {},
      "lint": {},
      "doc": {}
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.18"
  }
}
