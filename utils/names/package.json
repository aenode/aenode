{
  "name": "@aenode/names",
  "version": "0.0.17",
  "description": "Utility function to create text variants",
  "keywords": [
    "names",
    "casing",
    "pascalCase",
    "camelCase",
    "snakeCase",
    "titleCase",
    "kebabCase",
    "sentenceCase"
  ],
  "license": "BSL-1.0",
  "author": {
    "email": "aenode+names@proton.me",
    "name": "Ahmet Emrebas",
    "url": "https://aenode.github.io"
  },
  "homepage": "https://aenode.github.io/aenode/utils/names",
  "funding": [
    "https://cash.app/$puqlib"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@aenode/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "sourceRoot": "utils/names/src",
    "tags": [
      "lib:utils"
    ],
    "targets": {
      "build": {},
      "lint": {},
      "doc": {}
    }
  },
  "dependencies": {
    "@swc/helpers": "~0.5.18"
  },
  "devDependencies": {
    "@aenode/errors": "workspace:*",
    "@aenode/types": "workspace:*"
  },
  "peerDependencies": {
    "@aenode/errors": "workspace:*",
    "@aenode/types": "workspace:*"
  }
}
