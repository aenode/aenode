{
  "name": "@aenode/is",
  "version": "0.0.4",
  "description": "Common validation and transformation functions to stream line the conditional statements and transforming values",
  "keywords": [
    "types"
  ],
  "license": "BSL-1.0",
  "author": {
    "email": "aenode+is@proton.me",
