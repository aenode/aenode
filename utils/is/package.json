  "dependencies": {
    "@swc/helpers": "~0.5.18"
  },
  "devDependencies": {
    "@aenode/errors": "workspace:*",
    "@aenode/types": "workspace:*"
  },
  "peerDependencies": {
    "@aenode/types": "workspace:*",
    "@aenode/errors": "workspace:*"
