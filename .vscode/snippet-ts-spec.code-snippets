            "describe('sampleTest', () => {",
            "   it('should work', ()=>{",
            "       expect(1).toEqual(1)",
            "   })",
            "});"
        ],
        "description": "Create a describe block",
        "scope": "typescript"
    },
    "Vitest: Test Suite (describe)": {
        "prefix": "test desc",
        "body": [
            "describe('$1', () => {",
            "\t$0",
            "});"
        ],
        "description": "Create a describe block",
        "scope": "typescript"
    },
    "Vitest: Test Case (it)": {
        "prefix": "test it",
        "body": [
            "it('$1', $2() => {",
