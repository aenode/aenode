{
    "model": {
        "prefix": "model",
        "description": "Base model",
        "body": [
            "model $1 {",
            "  id Int @id @default(autoincrement())",
            "",
            "  createdAt DateTime  @default(now()) @db.Timestamptz(6)",
            "  updatedAt DateTime  @updatedAt @db.Timestamptz(6)",
            "  deletedAt DateTime? @db.Timestamptz(6)",
            "  isActive  Boolean?  @default(true)",
            "}"
        ],
        "scope": "prisma",
    },
    "field uuid": {
        "prefix": "field uuid",
        "description": "Uuid field",
        "body": [
            "${1:uuid} String @unique @default(uuid(7)) @db.Uuid",
            "$0"
        ],
        "scope": "prisma",
    },
    "field date": {
        "prefix": "field date",
        "description": "Date field",
        "body": [
            " $1 DateTime @db.Date",
            "$0"
        ],
        "scope": "prisma",
    },
    "field timestamp": {
        "prefix": "field timestamp",
        "description": "Date field",
        "body": [
            "$1 DateTime? @db.Timestamptz(6)",
            "$0"
        ],
        "scope": "prisma",
    },
    "field time": {
        "prefix": "field time",
        "description": "Time field",
        "body": [
            "$1 DateTime? @db.Time(0)",
            "$0"
        ],
        "scope": "prisma",
    },
    "field short text": {
        "prefix": "field short text",
        "description": "Name field",
        "body": [
            "$1 String @db.VarChar(255)",
            "$0"
        ],
        "scope": "prisma",
    },
    "field short text unique": {
        "prefix": "field short text unique",
        "description": "Unique short text field",
        "body": [
            "$1 String @unique @db.VarChar(255)",
            "$0"
        ],
        "scope": "prisma",
    },
    "field text": {
        "prefix": "field text",
        "description": "Text field",
        "body": [
            "$1 String? @db.Text",
            "$0"
        ],
        "scope": "prisma",
    },
    "field money": {
        "prefix": "field money",
        "description": "Money field",
        "body": [
            "$1 Decimal @db.Decimal(12, 6)",
            "$0"
        ],
        "scope": "prisma",
    },
    "field percent": {
        "prefix": "field percent",
        "description": "Percent field",
        "body": [
            " $1 Decimal @default(0.0000) @db.Decimal(5, 4)",
            "$0"
        ],
        "scope": "prisma",
    },
    "field json": {
        "prefix": "field json",
        "description": "Json  field",
        "body": [
            "$1 Json @default(\"{}\") @db.JsonB",
            "$0"
        ],
        "scope": "prisma",
    },
    "field binary": {
        "prefix": "field binary",
        "description": "Binary field for avatar and small files",
        "body": [
            "$1 Bytes? @db.ByteA",
            "$0"
        ],
        "scope": "prisma",
    },
    "field text array": {
        "prefix": "field text array",
        "description": "Text array field",
        "body": [
            "$1 String[] @db.Text",
            "$0"
        ],
        "scope": "prisma",
    },
}