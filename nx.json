{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        }
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "executor": "@nx/js:swc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "skipTypeCheck": false,
        "stripLeadingPaths": true
      }
    },
    "doc": {
      "executor": "nx:run-commands",
      "options": {
        "command": "typedoc --entryPointStrategy expand {projectRoot}/src --out public/{projectRoot} --tsconfig {projectRoot}/tsconfig.lib.json"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun --watch {projectRoot}/src/main.ts"
      }
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@nx/js:swc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },

    "docker:build": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "docker build -t aenode-$(basename {projectRoot}) {projectRoot}"
      }
    },
    "docker:run": {
      "executor": "nx:run-commands",
      "dependsOn": ["docker-build"],
      "options": {
        "command": "docker rm -f aenode-$(basename {projectRoot}) 2>/dev/null; docker run --name aenode-$(basename {projectRoot}) -p $PORT:$PORT -e PORT=$PORT aenode-$(basename {projectRoot})"
      }
    }
  },
  "generators": {
    "@nx/js:library": {
      "publishable": true,
      "linter": "eslint",
      "bundler": "swc",
      "unitTestRunner": "vitest"
    },
    "@aenode/plugin:library": {
      "orgname": "aenode",
      "authorName": "Ahmet Emrebas",
      "email": "aenode+npm@proton.me",
      "username": "aenode",
      "homepage": "https://aenode.github.io",
      "funding": "https://cash.app/$puqlib"
    }
  },
  "release": {
    "version": {
      "preVersionCommand": "bun nx run-many -t build"
    }
  }
}
