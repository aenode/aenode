{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "analytics": false,
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "ciTargetName": "test-ci",
        "testMode": "watch"
      },
      "exclude": ["apps/aenode-e2e/**/*"]
    },
    {
      "plugin": "@nx/vitest",
      "include": ["apps/aenode-e2e/**/*"],
      "options": {
        "testTargetName": "e2e",
        "ciTargetName": "e2e-ci",
        "testMode": "run"
      }
    }
  ],
  "targetDefaults": {
    "test": {},
    "e2e-ci--**/**": [
      {
        "filter": {
          "projects": ["@aenode/aenode-e2e"]
        },
        "dependsOn": ["@aenode/aenode:serve"]
      }
    ],
    "build": {
      "executor": "@nx/js:swc",
      "dependsOn": ["build", "^build"],
      "outputs": ["{options.outputPath}"],
      "syncGenerators": ["@nx/js:typescript-sync"],
      "options": {
        "outputPath": "{projectRoot}/dist",
        "main": "{projectRoot}/src/index.ts",
        "tsConfig": "{projectRoot}/tsconfig.lib.json",
        "skipTypeCheck": true,
        "stripLeadingPaths": true,
        "clean": true
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "bun --watch src/main.ts",
        "cwd": "{projectRoot}"
      }
    },
    "prisma:migrate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["bunx prisma migrate dev --name=updated"],
        "cwd": "{projectRoot}"
      }
    },
    "prisma:generate": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["bunx prisma generate"],
        "cwd": "{projectRoot}"
      }
    },
    "prisma:reset": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["bunx prisma migrate reset"],
        "cwd": "{projectRoot}"
      }
    },
    "doc": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "typedoc --entryPointStrategy expand {projectRoot}/src --out public/{projectRoot} --tsconfig {projectRoot}/tsconfig.lib.json --favicon {projectRoot}/assets/favicon.svg"
        ]
      }
    }
  },
  "generators": {
    "@aenode/plugin:project": {
      "orgName": "aenode",
      "aenodeVersion": "0.0.42",
      "version": "0.0.42"
    }
  },
  "release": {
    "version": {
      "preVersionCommand": "bunx nx run-many -t build"
    }
  }
}
